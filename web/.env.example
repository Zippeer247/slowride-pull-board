# ── Data ────────────────────────────────────────────────────────────
# mock = generated test orders from real products (no keys needed)
# live = real orders from both Shopify stores (read-only)
DATA_SOURCE=mock
# live = real orders only; rehearsal = ONLY orders tagged "rehearsal"/"training"
BOARD_MODE=live
# Go-live cutoff: orders before this never show (ISO time). Leave empty to use LOOKBACK_DAYS.
BOARD_START_AT=
LOOKBACK_DAYS=7

# ── Shopify (client-credentials apps, scope: read_orders) ───────────
SUPPLY_SHOPIFY_DOMAIN=vwzbpx-m4.myshopify.com
SUPPLY_SHOPIFY_CLIENT_ID=
SUPPLY_SHOPIFY_CLIENT_SECRET=
GARAGE_SHOPIFY_DOMAIN=slowridegarage.myshopify.com
GARAGE_SHOPIFY_CLIENT_ID=
GARAGE_SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CACHE_SECONDS=15

# ── Screens ─────────────────────────────────────────────────────────
# Long random string (openssl rand -hex 24). Required in production: without it every request
# is refused. The board URL is /display?screen=front#key=<this>
DISPLAY_KEY=
AMBER_MIN=15
RED_MIN=30
# Over this many minutes, "To pull" flashes red
ALARM_MIN=60
UNDO_MIN=15

# ── Pulled-state storage (Upstash Redis from the Vercel Marketplace) ─
# Leave empty locally to keep state in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Mock only ───────────────────────────────────────────────────────
MOCK_ORDERS_PER_HOUR=4
MOCK_WINDOW_MIN=120
